<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <LangVersion>14</LangVersion>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>Cdp.Deploy</RootNamespace>

    <AssemblyName>Cdp.Deploy</AssemblyName>

    <Version>0.1.0</Version>

    <GuidersPlatformVersion Condition="'$(GuidersPlatformVersion)' == ''">0.4.1</GuidersPlatformVersion>

    <AuthoringToolchainRoot Condition="'$(AuthoringToolchainRoot)' == ''">$(MSBuildThisFileDirectory)..\..\authoring-toolchain\</AuthoringToolchainRoot>

    <_GuidersPlatformBin Condition="'$(_GuidersPlatformBin)' == ''">$(GuidersPlatformRoot)\src</_GuidersPlatformBin>

  </PropertyGroup>

  <Import Project="$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props"

          Condition="Exists('$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props')" />

  <PropertyGroup Condition="Exists('$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props')">

    <GdlEmitProject>$(MSBuildThisFileDirectory)..\authoring\cdp-mcp.gdlproj</GdlEmitProject>

    <GdlEmitNamespace>Cdp.Deploy.Generated</GdlEmitNamespace>

    <GdlEmitOutputDir>$(MSBuildThisFileDirectory)Generated</GdlEmitOutputDir>

  </PropertyGroup>

  <ItemGroup>

    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">

      <_Parameter1>CdpMcp.Tests</_Parameter1>

    </AssemblyAttribute>

  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Tomlyn" Version="2.10.1" />

  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalGuidersPlatform)' == 'true'">

    <Reference Include="AIGuiders.Platform.Execution.CommandPlane.Catalog">

      <HintPath>$(_GuidersPlatformBin)\AIGuiders.Platform.Execution.CommandPlane.Catalog\bin\Release\net10.0\AIGuiders.Platform.Execution.CommandPlane.Catalog.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.Authoring.Command.Catalog">

      <HintPath>$(_GuidersPlatformBin)\AIGuiders.Platform.Authoring.Command.Catalog\bin\Release\net10.0\AIGuiders.Platform.Authoring.Command.Catalog.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.IntermediateRepresentation.Command">

      <HintPath>$(_GuidersPlatformBin)\AIGuiders.Platform.IntermediateRepresentation.Command\bin\Release\net10.0\AIGuiders.Platform.IntermediateRepresentation.Command.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.Modeling.Catalog">

      <HintPath>$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Catalog\bin\Release\net10.0\AIGuiders.Platform.Modeling.Catalog.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.Modeling.Gdl.Command">

      <HintPath>$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Command\bin\Release\net10.0\AIGuiders.Platform.Modeling.Gdl.Command.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.Modeling.Notations.Argument">

      <HintPath>$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Notations.Argument\bin\Release\net10.0\AIGuiders.Platform.Modeling.Notations.Argument.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.Notations">

      <HintPath>$(_GuidersPlatformBin)\AIGuiders.Platform.Notations\bin\Release\net10.0\AIGuiders.Platform.Notations.dll</HintPath>

    </Reference>

    <Reference Include="AIGuiders.Platform.Notations.Argument.Kv">

      <HintPath>$(_GuidersPlatformBin)\AIGuiders.Platform.Notations.Argument.Kv\bin\Release\net10.0\AIGuiders.Platform.Notations.Argument.Kv.dll</HintPath>

    </Reference>

  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalGuidersPlatform)' != 'true'">

    <PackageReference Include="AIGuiders.Platform.Execution.CommandPlane.Catalog" Version="$(GuidersPlatformVersion)" />

    <PackageReference Include="AIGuiders.Platform.Authoring.Command.Catalog" Version="$(GuidersPlatformVersion)" />

    <PackageReference Include="AIGuiders.Platform.Notations.Argument.Kv" Version="$(GuidersPlatformVersion)" />

  </ItemGroup>

  <ItemGroup>

    <EmbeddedResource Include="Resources\cdp-mcp.defaults.toml" />

  </ItemGroup>

</Project>


