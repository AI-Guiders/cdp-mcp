<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cdp.Deploy</RootNamespace>
    <AssemblyName>Cdp.Deploy</AssemblyName>
    <Version>0.1.0</Version>
    <GuidersPlatformVersion Condition="'$(GuidersPlatformVersion)' == ''">0.31.0</GuidersPlatformVersion>
    <AuthoringToolchainRoot Condition="'$(AuthoringToolchainRoot)' == ''">$(MSBuildThisFileDirectory)..\..\authoring-toolchain\</AuthoringToolchainRoot>
  </PropertyGroup>
  <!-- GDL catalog emit (GUIDERS-ADR-0065): authoring/cdp-mcp.gdlproj → Generated/CdpDeployCatalog.g.cs -->
  <Import Project="$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props"
          Condition="Exists('$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props')" />
  <PropertyGroup Condition="Exists('$(AuthoringToolchainRoot)\build\Platform.Gdl.Emit.props')">
    <GdlEmitProject>$(MSBuildThisFileDirectory)..\authoring\cdp-mcp.gdlproj</GdlEmitProject>
    <GdlEmitNamespace>Cdp.Deploy.Generated</GdlEmitNamespace>
    <GdlEmitOutputDir>$(MSBuildThisFileDirectory)Generated</GdlEmitOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CdpMcp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalGuidersPlatform)' == 'true'">
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Notations.Argument.Kv\AIGuiders.Platform.Notations.Argument.Kv.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalGuidersPlatform)' != 'true'">
    <PackageReference Include="AIGuiders.Platform.Notations.Argument.Kv" Version="$(GuidersPlatformVersion)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\cdp-mcp.defaults.toml" />
  </ItemGroup>
</Project>
