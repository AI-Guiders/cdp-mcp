<Project>
  <!-- Local overrides (not committed). See REPO_STRUCTURE.md / agent-forge pattern. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <GuidersCoreRoot Condition="'$(GuidersCoreRoot)' == ''">$(MSBuildThisFileDirectory)..\guiders-core</GuidersCoreRoot>
    <GuidersPlatformRoot Condition="'$(GuidersPlatformRoot)' == ''">$(MSBuildThisFileDirectory)..\guiders-platform</GuidersPlatformRoot>
    <GuidersFSharpRoot Condition="'$(GuidersFSharpRoot)' == ''">$(MSBuildThisFileDirectory)..\guiders-fsharp</GuidersFSharpRoot>
    <!-- aid-publish -UseNuGet → AidUseNuGet=true overrides sibling auto-detect -->
    <UseLocalGuidersCore Condition="'$(UseLocalGuidersCore)' == '' and '$(AidUseNuGet)' == 'true'">false</UseLocalGuidersCore>
    <UseLocalGuidersPlatform Condition="'$(UseLocalGuidersPlatform)' == '' and '$(AidUseNuGet)' == 'true'">false</UseLocalGuidersPlatform>
    <UseLocalGuidersCore Condition="'$(UseLocalGuidersCore)' == '' and '$(AidUseNuGet)' != 'true' and Exists('$(GuidersCoreRoot)\src\Cdp.Core\Cdp.Core.csproj')">true</UseLocalGuidersCore>
    <UseLocalGuidersPlatform Condition="'$(UseLocalGuidersPlatform)' == '' and '$(AidUseNuGet)' != 'true' and Exists('$(GuidersPlatformRoot)\src\AIGuiders.Platform.CommandPlane\AIGuiders.Platform.CommandPlane.csproj')">true</UseLocalGuidersPlatform>
    <UseLocalGuidersFSharp Condition="'$(UseLocalGuidersFSharp)' == '' and '$(AidUseNuGet)' != 'true' and Exists('$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Language.Adapters.Fcs\AIGuiders.Platform.Modeling.Language.Adapters.Fcs.fsproj')">true</UseLocalGuidersFSharp>
    <!-- Transitive from OutWit.Database; CdpMcp has no aspects. Avoids OOM (Killed: 9) on macOS CI. -->
    <AspectInjector_Enabled>false</AspectInjector_Enabled>
    <FcsProjInfoProbeExe>$(GuidersFSharpRoot)\tools\FcsProjInfoProbe\bin\$(Configuration)\net10.0\FcsProjInfoProbe.exe</FcsProjInfoProbeExe>
  </PropertyGroup>

  <Target Name="BuildFcsProjInfoProbe"
          BeforeTargets="Build"
          Condition="'$(UseLocalGuidersFSharp)' == 'true' and Exists('$(GuidersFSharpRoot)\tools\FcsProjInfoProbe\FcsProjInfoProbe.fsproj')">
    <MSBuild Projects="$(GuidersFSharpRoot)\tools\FcsProjInfoProbe\FcsProjInfoProbe.fsproj"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyFcsProjInfoProbe"
          AfterTargets="Build"
          Condition="'$(UseLocalGuidersFSharp)' == 'true' and Exists('$(FcsProjInfoProbeExe)') and '$(OutputPath)' != ''">
    <ItemGroup>
      <_FcsProjInfoProbeAssets Include="$(GuidersFSharpRoot)\tools\FcsProjInfoProbe\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FcsProjInfoProbeAssets)"
          DestinationFiles="@(_FcsProjInfoProbeAssets->'$(OutputPath)tools\FcsProjInfoProbe\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
