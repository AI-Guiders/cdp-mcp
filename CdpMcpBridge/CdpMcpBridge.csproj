<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CdpMcpBridge</RootNamespace>
    <AssemblyName>CdpMcpBridge</AssemblyName>
    <Version>0.2.0</Version>
    <GuidersCoreRoot Condition="'$(GuidersCoreRoot)' == ''">..\..\guiders-core</GuidersCoreRoot>
    <UseLocalGuidersCore Condition="'$(UseLocalGuidersCore)' == ''">false</UseLocalGuidersCore>
    <TerminalMcpCoreVersion Condition="'$(TerminalMcpCoreVersion)' == ''">0.1.5</TerminalMcpCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CdpMcp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(GuidersCoreRoot)\src\TerminalMcp.Core\TerminalMcp.Core.csproj" Condition="'$(UseLocalGuidersCore)' == 'true'" />
    <PackageReference Include="AIGuiders.TerminalMcp.Core" Version="$(TerminalMcpCoreVersion)" Condition="'$(UseLocalGuidersCore)' != 'true'" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Tomlyn" Version="2.9.0" />
  </ItemGroup>
</Project>
