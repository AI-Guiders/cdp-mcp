version = 1
default_phase = "recall"
default_object = "kb"

[memory]
notes_config = "/path/to/agent-notes-mcp.toml"
task_config = "/path/to/agent-task-knowledge-mcp.toml"

[memory.world]
enabled = true
roots = ["worlds", "META"]

[memory.project]
enabled = true
# work/projects = task-bound; personal = free-theme Kolb (personal/kolb)
roots = ["work/projects", "personal"]

[memory.task]
enabled = true

[memory.session]
enabled = true

[memory.skill]
enabled = true
roots = ["domains", "templates"]

[memory.self.finding]
enabled = true

[memory.self.failure]
enabled = true

[dev.debug]
enabled = true

[dev.build]
enabled = true

[dev.roslyn]
enabled = true

[dev.git]
enabled = true

[dev.codebase_index]
enabled = true

[dev.anui]
enabled = true

# Language axis — not a closed enum. Omit section → built-in defaults (csharp/typescript/python/delphi/powershell).
[languages]
ids = ["csharp", "typescript", "python", "delphi", "powershell"]

[languages.aliases]
cs = "csharp"
"c#" = "csharp"
ts = "typescript"
tsx = "typescript"
py = "python"
pas = "delphi"
objectpascal = "delphi"
ps1 = "powershell"
pwsh = "powershell"
ps = "powershell"

[[languages.detect]]
id = "csharp"
kind = "sln"
extension = ".sln"
priority = 10

[[languages.detect]]
id = "csharp"
kind = "sln"
extension = ".slnx"
priority = 11

[[languages.detect]]
id = "csharp"
kind = "csproj"
extension = ".csproj"
priority = 20

[[languages.detect]]
id = "typescript"
kind = "tsconfig"
file_name = "tsconfig.json"
priority = 30

[[languages.detect]]
id = "python"
kind = "pyproject"
file_name = "pyproject.toml"
priority = 40

[[languages.detect]]
id = "powershell"
kind = "ps1"
extension = ".ps1"
priority = 50

[[languages.detect]]
id = "powershell"
kind = "psm1"
extension = ".psm1"
priority = 51

# LSP presets — commodity IDE verbs (definition/rename/codeAction…) for non-Roslyn languages.
# Omit → built-in: basedpyright-langserver, fallback pyright-langserver (npm/pip on PATH).
# Open pyright codeAction ≈ createTypeStub only; basedpyright adds auto-import quickfixes.
# [[languages.lsp]]
# id = "python"
# command = "basedpyright-langserver"
# args = ["--stdio"]
# language_ids = ["python"]
# root_markers = ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "pyrightconfig.json", ".git"]

# Intent workspace (scenes/stages) — WitDatabase persist
[intent_workspace]
# database_path = "C:/Users/YOU/AppData/Local/cdp-mcp/intent-workspace.witdb"

# Operator GUI cockpit host (Start/Stop). Process layer — remount MCP after edit.
# Windows-first SSOT = WPF Glass (ADR-0021). Avalonia CascadeIDE.exe is agent IDE, not operator glass.
# path= on start overrides once; CDP_COCKPIT_HOST_EXE env is escape only.
[cockpit_host]
# exe = "D:/Experiments/Personal Cursor Folder/Financial/software/open/cascade-ide/CDP.GlassCockpit.Windows/bin/Release/net10.0-windows/CDP.GlassCockpit.Windows.exe"

